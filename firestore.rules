rules_version = '2';

// GymFlow security rules
// - Each signed-in member can read and write ONLY their own data under /users/{their uid}.
// - The owner (isSuper) can do everything below and decides what other people may do (collection /staff):
//     view  -> can read the member list and their workouts (read only)
//     stars -> can give and remove stars (never to themselves)
// - Unique usernames live in /usernames/{name}: one document per name, so a name can never be held twice.
// Paste this into: Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The owner. Same id as js/roles.js. You can list more than one id: ['id1', 'id2']
    function isSuper() {
      return request.auth != null && request.auth.uid in ['sgwJTqVeQxa1JBCjLqgKSNYZcNj2'];
    }

    // The owner, or someone the owner gave this permission to
    function perm(p) {
      return isSuper() || (
        request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get(p, false) == true
      );
    }

    // profile document
    match /users/{uid} {
      allow read: if isOwner(uid) || perm('view') || perm('stars');
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.size() < 100;

      // stars
      match /rewards/{docId} {
        allow read: if isOwner(uid) || perm('view') || perm('stars');
        allow create, update: if perm('stars')
          && (uid != request.auth.uid || isSuper())
          && request.resource.data.id == docId
          && request.resource.data.keys().hasOnly(['id', 'stars', 'note', 'at', 'by', 'byName'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.stars is int
          && request.resource.data.stars >= -1000
          && request.resource.data.stars <= 1000;
        allow delete: if perm('stars') && (uid != request.auth.uid || isSuper());
      }

      // plans, workouts, bodyweight, measurements, exercises
      match /{collection}/{docId} {
        allow read: if (isOwner(uid) || perm('view'))
          && collection in ['plans', 'workouts', 'bodyweight', 'measurements', 'exercises'];
        allow delete: if isOwner(uid)
          && collection in ['plans', 'workouts', 'bodyweight', 'measurements', 'exercises'];
        allow create, update: if isOwner(uid)
          && collection in ['plans', 'workouts', 'bodyweight', 'measurements', 'exercises']
          && request.resource.data.id == docId;
      }
    }

    // what each person is allowed to do (only the owner writes; a person can read their own)
    match /staff/{uid} {
      allow read: if isOwner(uid) || isSuper();
      allow create, update: if isSuper()
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'view', 'stars', 'at', 'by']);
      allow delete: if isSuper();
    }

    // unique usernames: the document id is the lower-case name
    match /usernames/{key} {
      allow get: if request.auth != null;
      allow list: if perm('view') || perm('stars');
      allow create: if request.auth != null
        && key.size() >= 3 && key.size() <= 20
        && !(key in ['admin', 'administrator', 'owner', 'support', 'gymflow', 'root'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name.lower() == key
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey == key;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isSuper());
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
